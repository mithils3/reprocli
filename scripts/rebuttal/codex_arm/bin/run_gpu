#!/usr/bin/env python3
"""run_gpu for the Codex arm, run inside the Apptainer sandbox.

Forwards one call to the host bridge (codex_run.py), which runs the harness's own
``run_gpu`` handler, so allocation, budget metering and evidence match the thin harness.
Prints the handler's result as JSON. Exit 0 when the result is ok, 1 otherwise.
"""

import argparse
import json
import os
import sys
import time
import uuid
from pathlib import Path

BRIDGE = Path(os.environ.get("CODEX_ARM_BRIDGE", "/codex_io/bridge"))


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="run_gpu",
        description="Run one shell command on a metered GPU allocation (salloc held across calls).",
    )
    parser.add_argument("command", nargs="?", default="", help="shell command to run on the GPU node")
    parser.add_argument("--gpus", type=int, help="GPUs per node (default 1)")
    parser.add_argument("--minutes", type=int, help="allocation lifetime in minutes (default 30)")
    parser.add_argument("--partition", help="SLURM partition override")
    parser.add_argument("--release", action="store_true", help="release the held allocation after this step")
    opts = parser.parse_args()

    raw = {
        "command": opts.command,
        "gpus": opts.gpus,
        "minutes": opts.minutes,
        "partition": opts.partition,
        "release": opts.release or None,
    }
    arguments = {key: value for key, value in raw.items() if value not in (None, "")}
    rid = f"{time.strftime('%Y%m%dT%H%M%S')}-{uuid.uuid4().hex[:8]}"
    request = BRIDGE / "req" / f"{rid}.json"
    staged = BRIDGE / "req" / f"{rid}.tmp"
    staged.write_text(json.dumps({"id": rid, "arguments": arguments}), encoding="utf-8")
    os.replace(staged, request)

    reply = BRIDGE / "res" / f"{rid}.json"
    while not reply.exists():
        time.sleep(1)
    result = json.loads(reply.read_text(encoding="utf-8"))
    reply.unlink()
    print(json.dumps(result, indent=2))
    return 0 if result.get("ok") else 1


if __name__ == "__main__":
    sys.exit(main())
