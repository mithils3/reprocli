{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "paper_id",
    "central_claim",
    "match_bar_kind",
    "target_metric",
    "target_scope",
    "reference_value",
    "op",
    "tolerance",
    "execution_verified",
    "execution_evidence",
    "measured_value",
    "measured_citation",
    "cheat_flags",
    "value_comparison",
    "methodology_notes",
    "score",
    "confidence",
    "rationale"
  ],
  "properties": {
    "paper_id": {"type": "string"},
    "central_claim": {"type": "string"},
    "match_bar_kind": {"type": "string", "enum": ["point_estimate", "threshold", "direction", "magnitude", "none"]},
    "target_metric": {"type": "string"},
    "target_scope": {"type": "string"},
    "reference_value": {"type": ["number", "null"]},
    "op": {"type": "string"},
    "tolerance": {"type": ["number", "null"]},
    "execution_verified": {"type": "boolean"},
    "execution_evidence": {"type": "string"},
    "measured_value": {"type": ["number", "null"]},
    "measured_citation": {"type": "string"},
    "cheat_flags": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "evidence",
          "severity"
        ],
        "properties": {
          "kind": {"type": "string", "enum": ["hardcoded_constant", "echoed_prose_number", "self_scored_or_fabricated", "wrong_split_scale_dataset", "cherry_picked_metric", "stale_artifact", "retrieved_benchmark_answer", "other_provenance_break"]},
          "evidence": {"type": "string"},
          "severity": {"type": "string", "enum": ["low", "med", "high"]}
        }
      }
    },
    "value_comparison": {"type": "string"},
    "methodology_notes": {"type": "string"},
    "score": {"type": "integer", "minimum": 0, "maximum": 10},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "rationale": {"type": "string"}
  }
}
